# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8080
# Bind to the LAN so phones can reach it. Use 127.0.0.1 to restrict to the Pi only.
HOST=0.0.0.0
NODE_ENV=production

# --- Paths ---
DB_PATH=./data/board.db
CONFIG_PATH=./config.json
BACKUP_DIR=./backups

# --- Google OAuth (Calendar) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Application type: "Desktop app". See README section "Google Calendar setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./data/google-token.json
# Read-only display only needs calendar.readonly; creating events from the board needs:
#   https://www.googleapis.com/auth/calendar.events (the default below)
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events
# How often to pull calendar changes, in seconds.
CALENDAR_POLL_SECONDS=60

# --- Phase 2 placeholders (unused in Phase 1) ---
TODOIST_TOKEN=

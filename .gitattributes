# The Pi runs these. A CRLF shebang is a "bad interpreter" error on Linux, so
# force LF on everything that gets executed or parsed there.
* text=auto eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.png binary
